<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>네온 타입 어택 - NEON TYPER</title>
    <style>
        :root {
            --primary-color: #00ffff;
            --secondary-color: #ff0055;
            --container-glow: rgba(0, 255, 255, 0.25);
            --box-glow-color: #00ffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', sans-serif;
        }
        body {
            background-color: #070710;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            padding: 20px 0;
        }

        .bg-glow {
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,0,85,0.15) 0%, transparent 70%);
            top: 10%;
            left: 20%;
            z-index: -1;
            animation: floatGlow 8s infinite alternate ease-in-out;
        }
        .bg-glow-2 {
            position: absolute;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(0,255,255,0.15) 0%, transparent 70%);
            bottom: 10%;
            right: 20%;
            z-index: -1;
            animation: floatGlow 10s infinite alternate-reverse ease-in-out;
        }
        @keyframes floatGlow {
            0% { transform: translateY(0px) scale(1); }
            100% { transform: translateY(40px) scale(1.1); }
        }

        .container {
            text-align: center;
            background: rgba(20, 20, 35, 0.85);
            backdrop-filter: blur(10px);
            padding: 25px;
            border-radius: 25px;
            box-shadow: 0 0 40px rgba(255, 0, 128, 0.3);
            border: 2px solid var(--container-glow);
            max-width: 540px;
            width: 92%;
            animation: containerPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transition: border-color 0.4s ease;
        }
        @keyframes containerPop {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .logo-wrapper {
            width: 100%;
            max-width: 380px;
            margin: 0 auto 5px auto;
        }
        .logo-wrapper svg {
            width: 100%;
            height: auto;
            display: block;
        }

        p {
            color: #8f8fa8;
            font-size: 13px;
            margin-bottom: 12px;
        }
        .screen {
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }
        .screen.active {
            display: block;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .tab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }
        .tab-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #8f8fa8;
            padding: 8px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: bold;
            font-size: 12px;
            transition: all 0.25s;
        }
        .tab-btn:hover {
            border-color: var(--primary-color);
            color: #fff;
            transform: translateY(-2px);
        }
        .tab-btn.active {
            background: linear-gradient(45deg, #ff0055, #7928ca);
            color: white;
            border-color: transparent;
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.5);
            transform: scale(1.02);
        }

        .auth-container {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 0, 85, 0.3);
            border-radius: 15px;
            padding: 12px;
            margin-bottom: 12px;
        }
        .auth-input {
            width: 100%;
            padding: 8px 12px;
            margin-bottom: 6px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 8px;
            color: white;
            font-size: 13px;
            outline: none;
        }
        .auth-input:focus {
            border-color: var(--primary-color);
        }
        .auth-btn-group {
            display: flex;
            gap: 6px;
        }
        .auth-sub-btn {
            flex: 1;
            padding: 8px;
            font-size: 12px;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
        }
        .login-btn { background: var(--primary-color); color: #000; }
        .signup-btn { background: rgba(255,255,255,0.2); color: #fff; }
        .auth-sub-btn:hover { filter: brightness(1.2); }

        .user-profile {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
        }
        .admin-badge {
            background: #ff0055;
            color: #fff;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
            margin-left: 5px;
        }
        .logout-btn {
            background: rgba(255, 0, 85, 0.2);
            border: 1px solid #ff0055;
            color: #ff0055;
            padding: 4px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 11px;
        }

        .btn {
            background: linear-gradient(45deg, var(--primary-color), #0070f3);
            border: none;
            color: #070710;
            padding: 12px 30px;
            font-size: 15px;
            font-weight: 900;
            border-radius: 50px;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s;
            box-shadow: 0 4px 20px var(--container-glow);
            width: 100%;
            margin-top: 5px;
            text-transform: uppercase;
        }
        .btn:disabled {
            background: #444;
            color: #888;
            cursor: not-allowed;
            box-shadow: none;
        }

        .info-panel {
            display: flex;
            justify-content: space-around;
            margin-bottom: 15px;
            font-size: 15px;
            font-weight: bold;
        }
        #score { color: var(--primary-color); }
        #statValue { color: #ff0055; }
        #combo { color: #ffe600; }
        
        .word-display {
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 20px;
            color: #fff;
            letter-spacing: 1px;
            min-height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .input-box {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            text-align: center;
            background: rgba(0, 0, 0, 0.4);
            border: 2px solid #ff0055;
            border-radius: 12px;
            color: white;
            outline: none;
            margin-bottom: 10px;
        }

        .ranking-box {
            background: rgba(0, 0, 0, 0.4);
            padding: 10px;
            border-radius: 12px;
            margin-bottom: 12px;
            font-size: 13px;
            color: var(--primary-color);
            border: 1px solid rgba(255, 255, 255, 0.1);
            max-height: 140px;
            overflow-y: auto;
            text-align: left;
        }
        .ranking-title {
            font-weight: bold;
            text-align: center;
            margin-bottom: 6px;
            color: #ff0055;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 4px;
        }
        .rank-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 6px;
            border-bottom: 1px dashed rgba(255,255,255,0.05);
        }

        .shop-btn {
            background: linear-gradient(45deg, #ffe600, #ff0055);
            color: #000;
            border: none;
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 12px;
            box-shadow: 0 0 15px rgba(255, 230, 0, 0.4);
            width: 100%;
        }
        .shop-modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 100;
            align-items: center;
            justify-content: center;
        }
        .shop-modal.active {
            display: flex;
        }
        .shop-content {
            background: #141423;
            border: 2px solid var(--primary-color);
            border-radius: 20px;
            padding: 20px;
            width: 92%;
            max-width: 550px;
            max-height: 85vh;
            overflow-y: auto;
            position: relative;
            box-shadow: 0 0 30px var(--container-glow);
        }
        .shop-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 10px;
            margin-bottom: 15px;
        }
        .shop-tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 15px;
        }
        .shop-tab-btn {
            flex: 1;
            padding: 7px 4px;
            background: rgba(255,255,255,0.1);
            border: none;
            color: #aaa;
            border-radius: 8px;
            cursor: pointer;
            font-size: 11px;
            font-weight: bold;
        }
        .shop-tab-btn.active {
            background: var(--primary-color);
            color: #000;
        }
        
        /* -------------------------------------------------------------
           🎯 칭호 빙고판 형태 (3열 그리드) 스타일
        ------------------------------------------------------------- */
        .title-bingo-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 10px;
        }
        .title-card {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 10px 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            min-height: 85px;
            text-align: center;
            transition: transform 0.2s;
        }
        .title-card:hover {
            border-color: var(--primary-color);
            transform: translateY(-2px);
        }
        .title-card-btn {
            width: 100%;
            margin-top: 6px;
            padding: 4px 0;
            font-size: 10px;
            font-weight: bold;
            border-radius: 6px;
            border: none;
            cursor: pointer;
        }

        .shop-item {
            background: rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 10px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .box-card {
            background: rgba(0,0,0,0.4);
            border: 1px solid var(--primary-color);
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 12px;
            text-align: left;
        }
        .box-card h4 {
            color: #ffe600;
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
        }
        .prob-table {
            background: rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px;
            padding: 6px 8px;
            font-size: 11px;
            margin-bottom: 8px;
            color: #ccc;
        }
        .prob-table div {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
        }
        .box-btn-group {
            display: flex;
            gap: 6px;
        }

        .buy-btn {
            flex: 1;
            background: var(--primary-color);
            color: #000;
            border: none;
            padding: 8px 10px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 11px;
        }
        .buy-btn:disabled {
            background: #444;
            color: #888;
            cursor: not-allowed;
        }
        .frag-btn {
            flex: 1;
            background: linear-gradient(45deg, #00ff80, #00ffff);
            color: #000;
            border: none;
            padding: 8px 10px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 11px;
            box-shadow: 0 0 8px rgba(0,255,128,0.4);
        }
        .frag-btn:disabled {
            background: #333;
            color: #666;
            box-shadow: none;
            cursor: not-allowed;
        }
        .equip-btn {
            background: #ff0055;
            color: #fff;
            border: none;
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 11px;
        }
        .buff-badge {
            background: rgba(255, 230, 0, 0.15);
            border: 1px solid #ffe600;
            color: #ffe600;
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: bold;
            margin-top: 6px;
            display: inline-block;
        }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(5, 7, 12, 0.92);
            backdrop-filter: blur(12px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        .modal-content-box { display: flex; flex-direction: column; align-items: center; position: relative; width: 90%; max-width: 400px; }

        .light-burst {
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, var(--box-glow-color) 0%, transparent 70%);
            opacity: 0;
            transform: scale(0.2);
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            pointer-events: none;
        }
        .light-burst.active {
            opacity: 0.7;
            transform: scale(1.5);
            animation: rotateBurst 8s linear infinite;
        }
        @keyframes rotateBurst {
            from { transform: scale(1.5) rotate(0deg); }
            to { transform: scale(1.5) rotate(360deg); }
        }

        .anim-box { width: 140px; height: 140px; margin-bottom: 15px; z-index: 2; }
        
        .anim-box.shake-100 { animation: boxShake100 0.15s infinite alternate; }
        .anim-box.shake-500 { animation: boxShake500 0.1s infinite alternate; }
        .anim-box.shake-1000 { animation: boxShake1000 0.07s infinite alternate; }

        @keyframes boxShake100 {
            0% { transform: translate(0, 0) rotate(0deg); }
            100% { transform: translate(-4px, 3px) rotate(-3deg); }
        }
        @keyframes boxShake500 {
            0% { transform: translate(-6px, 4px) rotate(-5deg); }
            100% { transform: translate(6px, -4px) rotate(5deg); }
        }
        @keyframes boxShake1000 {
            0% { transform: translate(-10px, 8px) rotate(-10deg) scale(1.05); }
            100% { transform: translate(10px, -8px) rotate(10deg) scale(1.15); }
        }

        .anim-box.open-pop { animation: boxPop 0.4s forwards ease-out; }

        @keyframes boxPop {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(0); opacity: 0; }
        }

        .result-card {
            background: rgba(20, 24, 36, 0.95);
            border: 2px solid var(--box-glow-color);
            border-radius: 20px;
            padding: 25px 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            box-shadow: 0 0 35px var(--box-glow-color);
            transform: scale(0.5);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 3;
            width: 100%;
        }
        .result-card.show { transform: scale(1); opacity: 1; }

        .reward-item {
            background: rgba(0,0,0,0.4);
            padding: 10px 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            font-size: 13px;
            border-left: 4px solid var(--primary-color);
        }
        .reward-item.rare { border-left-color: #ff0055; background: rgba(255, 0, 85, 0.15); }

        /* -------------------------------------------------------------
           ✨ 칭호 스타일
        ------------------------------------------------------------- */
        .title-badge {
            display: inline-block;
            font-weight: 900;
            padding: 2px 8px;
            border-radius: 6px;
            font-size: 11px;
            vertical-align: middle;
            margin-right: 4px;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .title-rookie { color: #a0a0c0; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05); }
        .title-god {
            background: linear-gradient(90deg, #ffe600, #ffffff, #ffe600, #ff8800);
            background-size: 200% auto;
            color: #000;
            box-shadow: 0 0 15px #ffe600, 0 0 25px #ffffff;
            animation: goldShimmer 1.5s linear infinite, pulseGlow 1s ease-in-out infinite alternate;
        }
        .title-immortal {
            background: linear-gradient(135deg, #00ff80, #00ffff, #00ff80);
            background-size: 200% auto;
            color: #000;
            box-shadow: 0 0 14px #00ff80;
            animation: goldShimmer 2s linear infinite;
        }
        .title-transcendent {
            background: linear-gradient(90deg, #ff0055, #ffe600, #00ffff, #aa00ff, #ff0055);
            background-size: 300% auto;
            color: #fff;
            text-shadow: 0 0 4px #000;
            border: 1px solid #fff;
            box-shadow: 0 0 18px #ff00ff;
            animation: goldShimmer 1.2s linear infinite;
        }
        .title-abyss { background: #aa00ff; color: #fff; box-shadow: 0 0 10px #aa00ff, inset 0 0 5px #fff; }
        .title-prob { background: linear-gradient(45deg, #ffe600, #ff5500); color: #000; box-shadow: 0 0 10px #ffe600; }
        .title-fate { background: linear-gradient(90deg, #ff0055, #ff4400); color: #fff; box-shadow: 0 0 12px #ff0055; }
        .title-pioneer { background: #00ffff; color: #000; box-shadow: 0 0 8px #00ffff; }
        .title-chaser { background: #0088ff; color: #fff; box-shadow: 0 0 8px #0088ff; }
        .title-bridge { background: #444466; color: #00ffff; border: 1px solid #00ffff; }

        .title-golden-soul { background: linear-gradient(45deg, #ffe600, #ffffff); color: #000; box-shadow: 0 0 12px #ffe600; font-weight: bold; }
        .title-light-runner { background: linear-gradient(90deg, #00ffff, #00ff80); color: #000; box-shadow: 0 0 12px #00ffff; }
        .title-wealth-lord { background: linear-gradient(135deg, #ff0055, #ffe600); color: #fff; text-shadow: 0 0 3px #000; box-shadow: 0 0 15px #ff0055; }
        .title-galaxy-apex { background: linear-gradient(90deg, #aa00ff, #0088ff, #00ffff); color: #fff; box-shadow: 0 0 15px #aa00ff; }
        .title-all-watcher { background: #ffffff; color: #000; box-shadow: 0 0 20px #ffffff, 0 0 10px #00ffff; border: 1px solid #000; animation: pulseGlow 0.8s infinite alternate; }

        /* 신규 뽑기 전용 칭호 스타일 */
        .title-time-ruler { background: linear-gradient(135deg, #00ffff, #aa00ff); color: #fff; box-shadow: 0 0 15px #aa00ff; }
        .title-golden-lord { background: linear-gradient(90deg, #ffe600, #ff8800); color: #000; box-shadow: 0 0 15px #ffe600; }
        .title-speed-myth { background: linear-gradient(45deg, #00ff80, #ffe600); color: #000; box-shadow: 0 0 12px #00ff80; }
        .title-dimension-prophet { background: #7928ca; color: #00ffff; border: 1px solid #00ffff; box-shadow: 0 0 10px #7928ca; }
        .title-night-guardian { background: linear-gradient(180deg, #101030, #0088ff); color: #fff; border: 1px solid #0088ff; }

        @keyframes goldShimmer { 0% { background-position: 0% center; } 100% { background-position: 200% center; } }
        @keyframes pulseGlow { 0% { transform: scale(1); } 100% { transform: scale(1.05); } }

        /* ===== 1:1 PvP ===== */
        .pvp-btn-main{width:100%;padding:14px;margin-bottom:12px;border:0;border-radius:10px;font-size:15px;font-weight:bold;cursor:pointer;font-family:inherit;color:#fff;background:linear-gradient(90deg,#ff0055,#aa00ff);box-shadow:0 0 15px rgba(255,0,85,.5)}
        .pvp-spinner{width:46px;height:46px;border:4px solid rgba(255,255,255,.15);border-top-color:var(--secondary-color);border-radius:50%;margin:25px auto 15px;animation:pvpSpin .8s linear infinite}
        @keyframes pvpSpin{to{transform:rotate(360deg)}}
        .pvp-vs-panel{display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,.05);border:1px solid rgba(255,0,85,.4);border-radius:12px;padding:12px 18px;margin:15px 0}
        .pvp-player{text-align:center;flex:1}.pvp-name{font-size:12px;color:#aaa;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .pvp-count{font-size:30px;font-weight:bold}.pvp-player.me .pvp-count{color:var(--primary-color)}.pvp-player.opp .pvp-count{color:var(--secondary-color)}
        .pvp-timer{font-size:26px;font-weight:bold;color:#ffe600;min-width:60px;text-align:center}
        .pvp-result-title{font-size:30px;margin:20px 0 8px}.pvp-win{color:#00ff88}.pvp-lose{color:#ff0055}.pvp-draw{color:#ffe600}

    </style>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

    <div class="bg-glow"></div>
    <div class="bg-glow-2"></div>

    <div class="container" id="mainContainer">
        <!-- 메인 홈 화면 -->
        <div id="homeScreen" class="screen active">
            <div class="logo-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 180" width="100%">
                    <defs>
                        <filter id="glow-cyan" x="-50%" y="-50%" width="200%" height="200%">
                            <feGaussianBlur stdDeviation="6" result="blur1" />
                            <feGaussianBlur stdDeviation="12" result="blur2" />
                            <feMerge>
                                <feMergeNode in="blur2" />
                                <feMergeNode in="blur1" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                        <filter id="glow-pink" x="-50%" y="-50%" width="200%" height="200%">
                            <feGaussianBlur stdDeviation="6" result="blur1" />
                            <feGaussianBlur stdDeviation="12" result="blur2" />
                            <feMerge>
                                <feMergeNode in="blur2" />
                                <feMergeNode in="blur1" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                        <linearGradient id="grad-cyan" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#00ffff" />
                            <stop offset="100%" stop-color="#0088ff" />
