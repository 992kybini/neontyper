        /* 🏆 랭킹판 조회 및 닉네임 [칭호] 파싱 버그 수정 완료 */
        async function fetchRankings() {
            const modeNames = { speed: '⚡ 스피드 러시', survive: '🛡️ 서바이벌', sentence: '📜 딥 센텐스', boss: '🐉 보스 레이드' };
            if (!supabaseClient) return;

            try {
                const { data, error } = await supabaseClient
                    .from('rankings')
                    .select('id, nickname, score')
                    .eq('mode', selectedMode)
                    .order('score', { ascending: false })
                    .limit(100);

                if (error) throw error;

                const uniqueRankings = [];
                const seenUsernames = new Set();

                if (data && data.length > 0) {
                    for (const row of data) {
                        // 💡 마지막 닫는 대괄호 ] 기준 정규표현식으로 버그 완벽 수정
                        let cleanName = row.nickname;
                        const match = row.nickname.match(/^\[(.*)\]\s*(.*)$/);
                        if (match) cleanName = match[2];

                        if (!seenUsernames.has(cleanName)) {
                            seenUsernames.add(cleanName);
                            uniqueRankings.push(row);
                        }

                        if (uniqueRankings.length === 3) break;
                    }
                }

                let html = `<div class="ranking-title">🏆 [${modeNames[selectedMode]}] 명예의 전당 TOP 3</div>`;
                const medals = ['🥇', '🥈', '🥉'];

                if (uniqueRankings.length > 0) {
                    uniqueRankings.forEach((row, index) => {
                        let adminControls = "";
                        if (isAdmin) {
                            adminControls = `
                                <span>
                                    <button class="admin-action-btn" style="background:none; border:none; cursor:pointer;" onclick="editRank(${row.id}, '${row.nickname}', ${row.score})">✏️</button>
                                    <button class="admin-action-btn" style="background:none; border:none; cursor:pointer;" onclick="deleteRank(${row.id}, '${row.nickname}')">🗑️</button>
                                </span>
                            `;
                        }
                        
                        let formattedName = row.nickname;
                        // 💡 대괄호가 칭호명에 포함되어 있어도 정확히 분리하는 정규식 적용
                        const match = row.nickname.match(/^\[(.*)\]\s*(.*)$/);
                        if (match) {
                            const titleStr = match[1];
                            const nameStr = match[2];
                            formattedName = `${renderTitleBadge(titleStr)} ${nameStr}`;
                        }

                        html += `
                            <div class="rank-item">
                                <span>${medals[index] || '•'} ${formattedName}</span> 
                                <span><strong>${row.score}점</strong> ${adminControls}</span>
                            </div>`;
                    });
                } else {
                    html += `<div style="text-align:center; padding:5px; color:#aaa;">등록된 기록이 없습니다. 첫 번째 주인공이 되어보세요!</div>`;
                }

                rankingView.innerHTML = html;
            } catch (e) {
                rankingView.innerHTML = `<div class="ranking-title">🏆 [${modeNames[selectedMode]}] 기록을 불러오지 못했습니다.</div>`;
            }
        }

        async function deleteRank(id, targetName) {
            if (!isAdmin) return;
            if (confirm(`개발자 권한: '${targetName}' 님의 기록을 삭제하시겠습니까?`)) {
                const { error } = await supabaseClient.from('rankings').delete().eq('id', id);
                if (!error) { fetchRankings(); alert("삭제되었습니다."); }
