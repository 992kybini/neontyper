        }

        async function editRank(id, oldName, oldScore) {
            if (!isAdmin) return;
            const newScore = prompt(`'${oldName}' 님의 점수 수정:`, oldScore);
            if (newScore !== null && !isNaN(newScore)) {
                const { error } = await supabaseClient.from('rankings').update({ score: parseInt(newScore) }).eq('id', id);
                if (!error) { fetchRankings(); alert("수정되었습니다."); }
            }
        }

