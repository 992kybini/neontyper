        async function openBox(tier, useFragment) {
            if (!userData.fragments) userData.fragments = { box500: 0, box1000: 0 };

            if (useFragment) {
                const fragKey = tier === 500 ? 'box500' : 'box1000';
                if (userData.fragments[fragKey] < 10) return alert("조각이 부족합니다!");
                userData.fragments[fragKey] -= 10;
            } else {
                if (userData.coins < tier) return alert("코인이 부족합니다!");
                userData.coins -= tier;
            }

            const modal = document.getElementById('boxOpenModal');
            const animBox = document.getElementById('animBox');
            const lightBurst = document.getElementById('lightBurst');
            const resultCard = document.getElementById('resultCard');
            const rewardList = document.getElementById('rewardList');
            const resultTitle = document.getElementById('resultTitle');

            let glowColor = "#00ffff";
            let boxFill = "#00ffff";
            let boxStroke = "#0088ff";

            if (tier === 500) {
                glowColor = "#ffe600";
                boxFill = "#ffe600";
                boxStroke = "#ffaa00";
            } else if (tier === 1000) {
                glowColor = "#ff0055";
                boxFill = "#ff0055";
                boxStroke = "#aa00ff";
            }

            document.documentElement.style.setProperty('--box-glow-color', glowColor);
            document.getElementById('boxPath1').setAttribute('fill', boxFill);
            document.getElementById('boxPath1').setAttribute('stroke', boxStroke);
            document.getElementById('boxPath2').setAttribute('stroke', boxStroke);
            document.getElementById('boxPath3').setAttribute('stroke', boxStroke);

            rewardList.innerHTML = '';
            resultCard.classList.remove('show');
            animBox.className = `anim-box shake-${tier}`;
            lightBurst.className = 'light-burst';
            modal.classList.add('active');

            let rewardsHTML = '';

            if (tier === 100) {
                userData.fragments.box500 += 1;
                rewardsHTML += `<div class="reward-item"><span>🧩 고급 상자 조각</span><strong>+1개 (확정)</strong></div>`;
            } else {
                userData.fragments.box1000 += 1;
                rewardsHTML += `<div class="reward-item"><span>🧩 전설 상자 조각</span><strong>+1개 (확정)</strong></div>`;
            }

            const jackpotProbs = { 100: 0.15, 500: 0.25, 1000: 0.40 };
            const jackpotAmounts = { 100: 300, 500: 1500, 1000: 5000 };

            if (Math.random() < jackpotProbs[tier]) {
                const winCoin = jackpotAmounts[tier];
                userData.coins += winCoin;
                rewardsHTML += `<div class="reward-item"><span>💰 코인 잭팟!</span><strong style="color:#ffe600;">+${winCoin.toLocaleString()} 코인</strong></div>`;
            } else {
                const smallPayback = Math.floor(tier * (0.1 + Math.random() * 0.2));
                userData.coins += smallPayback;
                rewardsHTML += `<div class="reward-item"><span>🪙 소액 코인 환급</span><strong>+${smallPayback} 코인</strong></div>`;
            }

            const titleProbs = { 100: 0.02, 500: 0.05, 1000: 0.10 };
            if (Math.random() < titleProbs[tier]) {
                const gachaTitles = ALL_TITLES.filter(t => !t.isShopBuyable && !userData.titles.includes(t.name));
                if (gachaTitles.length > 0) {
                    const drawn = gachaTitles[Math.floor(Math.random() * gachaTitles.length)];
                    userData.titles.push(drawn.name);
                    rewardsHTML += `<div class="reward-item rare"><span>👑 희귀 칭호 획득!</span><strong>${renderTitleBadge(drawn.name)}</strong></div>`;
                } else {
                    userData.coins += 300;
                    rewardsHTML += `<div class="reward-item"><span>👑 칭호 중복 보유 보상</span><strong>+300 코인</strong></div>`;
                }
            }

            await saveUserData();

            const delayTime = tier === 1000 ? 1500 : (tier === 500 ? 1200 : 900);
            setTimeout(() => {
                animBox.className = 'anim-box open-pop';
                lightBurst.classList.add('active');
                resultTitle.textContent = `${tier === 1000 ? '👑 전설' : (tier === 500 ? '🎁 고급' : '📦 일반')} 상자 개봉 완료!`;
                rewardList.innerHTML = rewardsHTML;

                setTimeout(() => {
                    resultCard.classList.add('show');
                }, 300);
            }, delayTime);
        }

