            initRound();
        }

        function goToHome() {
            clearInterval(gameInterval);
            isPlaying = false;
            isStarted = false;
            gameScreen.classList.remove('active');
            homeScreen.classList.add('active');
            fetchRankings();
            checkBuffState();
        }

        function initRound() {
            score = 0;
            combo = 0;
            isPlaying = true;
            isStarted = false;
            scoreEl.textContent = score;
            comboEl.textContent = combo;
            statValueEl.textContent = statValue;
            
            inputBox.value = "";
            inputBox.focus();
            nextWord();
        }

        function startTimerIfNeeded() {
            if (!isStarted) {
                isStarted = true;
                clearInterval(gameInterval);
                gameInterval = setInterval(() => {
                    statValue--;
                    statValueEl.textContent = statValue;
                    if (statValue <= 0) {
                        endGame();
                    }
                }, 1000);
            }
        }

        function nextWord() {
            let pool = selectedMode === 'sentence' ? sentencePool : (selectedMode === 'boss' ? bossPool : wordPool);
            const randomIndex = Math.floor(Math.random() * pool.length);
            currentWord = pool[randomIndex];
            wordDisplay.textContent = currentWord;

            if (selectedMode === 'survive' && isStarted) {
                statValue = 4; 
                statValueEl.textContent = statValue;
            }
        }

        let isComposing = false;
        inputBox.addEventListener('compositionstart', () => { isComposing = true; });
        inputBox.addEventListener('compositionend', () => { 
            isComposing = false; 
            if (inputBox.value.length > 0) startTimerIfNeeded();
            checkInput(); 
        });
        inputBox.addEventListener('input', () => {
            if (!isPlaying) return;
            if (inputBox.value.length > 0) startTimerIfNeeded();
            if (!isComposing) checkInput();
        });

        function checkInput() {
            const typedValue = inputBox.value.trim();
            if (typedValue === currentWord) {
                combo++;
                let addScore = selectedMode === 'sentence' ? 30 : (selectedMode === 'boss' ? 50 : 10);
                score += addScore + (combo >= 5 ? 10 : 0);
                
                scoreEl.textContent = score;
                comboEl.textContent = combo;
                
                inputBox.value = "";
                nextWord();
            }
        }

        async function endGame() {
            isPlaying = false;
            clearInterval(gameInterval);
            inputBox.value = "";
            wordDisplay.textContent = "GAME OVER 🛑";

            let earnedCoins = Math.floor(score / 12) + Math.floor(combo / 2);
            if (earnedCoins < 5 && score > 0) earnedCoins = 5;

            const isBuffActive = userData.coinBuffUntil && userData.coinBuffUntil > Date.now();
            if (isBuffActive) {
                earnedCoins = Math.floor(earnedCoins * 1.5);
            }

            userData.coins += earnedCoins;
            await saveUserData();

            if (supabaseClient) {
                try {
                    const fullPlayerName = `[${userData.equippedTitle}] ${username}`;
                    await supabaseClient
                        .from('rankings')
                        .insert([{ nickname: fullPlayerName, score: score, mode: selectedMode }]);

                    alert(`게임 종료!\n최종 점수: ${score}점\n💰 ${earnedCoins} 코인을 획득했습니다! ${isBuffActive ? '(⚡ 1.5배 부스트 적용)' : ''}`);
                } catch (e) {
                    alert(`게임 종료! 점수: ${score}점 | 💰 +${earnedCoins} 코인`);
                }
            }

            setTimeout(goToHome, 1500);
        }


        /* ==================== 1:1 PvP 모드 ==================== */
        const PVP_TIME=20;
        const pvpScreen=document.getElementById('pvpScreen'),pvpStatusBox=document.getElementById('pvpStatusBox'),pvpBattleBox=document.getElementById('pvpBattleBox'),pvpResultBox=document.getElementById('pvpResultBox');
const pvpStatusText=document.getElementById('pvpStatusText'),pvpWordDisplay=document.getElementById('pvpWordDisplay'),pvpInputBox=document.getElementById('pvpInputBox'),pvpTimerEl=document.getElementById('pvpTimerEl'),pvpMyWordsEl=document.getElementById('pvpMyWordsEl'),pvpOppWordsEl=document.getElementById('pvpOppWordsEl'),pvpMyNameEl=document.getElementById('pvpMyNameEl'),pvpOppNameEl=document.getElementById('pvpOppNameEl');
let pvpState='idle',pvpId=null,lobbyChannel=null,roomChannel=null,pvpOppId=null,pvpOppName='',pvpMyWords=0,pvpOppWords=0,pvpOppFinal=null,pvpSeq=[],pvpIdx=0,pvpTimeLeft=PVP_TIME,pvpGameIv=null,pvpCountIv=null,pvpFinishTimeout=null,pvpRoomGuard=null;
const pvpHash=function(s){let h=1779033703^s.length;for(let i=0;i<s.length;i++)h=Math.imul(h^s.charCodeAt(i),3432918353);return h>>>0};
function pvpRand(seed){return function(){seed=(seed+0x6D2B79F5)|0;let t=Math.imul(seed^(seed>>>15),1|seed);t=(t+Math.imul(t^(t>>>7),61|t))^t;return((t^(t>>>14))>>>0)/4294967296}};
function setPvpView(v){pvpStatusBox.style.display=v==='status'?'block':'none';pvpBattleBox.style.display=v==='battle'?'block':'none';pvpResultBox.style.display=v==='result'?'block':'none'}
function startMatchmaking(){if(!currentUser)return alert('로그인이 필요합니다.');if(!supabaseClient)return alert('서버에 연결할 수 없습니다.');if(pvpState!=='idle')return;pvpState='searching';pvpId=Date.now().toString(36)+Math.random().toString(36).slice(2,10);homeScreen.classList.remove('active');gameScreen.classList.remove('active');pvpScreen.classList.add('active');setPvpView('status');pvpStatusText.textContent='⏳ 상대를 찾는 중...';lobbyChannel=supabaseClient.channel('pvp-lobby',{config:{presence:{key:pvpId}}});lobbyChannel.on('presence',{event:'sync'},checkLobbyForMatch).on('presence',{event:'join'},checkLobbyForMatch);lobbyChannel.subscribe(async function(status){if(status==='SUBSCRIBED'){try{await lobbyChannel.track({name:username,t:Date.now()})}catch(e){}setTimeout(checkLobbyForMatch,300)}})}
function checkLobbyForMatch(){if(pvpState!=='searching'||!lobbyChannel)return;const st=lobbyChannel.presenceState(),ids=Object.keys(st).sort(),i=ids.indexOf(pvpId);if(ids.length<2||i<0)return;const opp=ids[i%2===0?i+1:i-1];if(opp){const meta=st[opp]&&st[opp][0]||{};enterPvpRoom(opp,meta.name||'상대')}}
async function enterPvpRoom(oppId,oppName){if(pvpState!=='searching')return;pvpState='matched';pvpOppId=oppId;pvpOppName=oppName;if(lobbyChannel){try{supabaseClient.removeChannel(lobbyChannel)}catch(e){}lobbyChannel=null}const roomId=[pvpId,oppId].sort().join('_'),r=pvpRand(pvpHash(roomId));pvpSeq=Array.from({length:400},()=>wordPool[Math.floor(r()*wordPool.length)]);roomChannel=supabaseClient.channel('pvp-room-'+roomId,{config:{presence:{key:pvpId},broadcast:{self:false}}});roomChannel.on('broadcast',{event:'score'},m=>{const p=m.payload;if(p&&p.id!==pvpId){pvpOppWords=p.words;updatePvpBoard()}}).on('broadcast',{event:'final'},m=>{const p=m.payload;if(p&&p.id!==pvpId){pvpOppFinal=p.words;pvpOppWords=p.words;tryShowPvpResult()}}).on('presence',{event:'sync'},()=>{if(Object.keys(roomChannel.presenceState()).length>=2)startPvpCountdown()});roomChannel.subscribe(async s=>{if(s==='SUBSCRIBED')try{await roomChannel.track({name:username})}catch(e){}});pvpRoomGuard=setTimeout(()=>{if(pvpState==='matched'){cleanupPvpChannels();pvpState='idle';startMatchmaking()}},12000)}
function updatePvpBoard(){pvpMyWordsEl.textContent=pvpMyWords;pvpOppWordsEl.textContent=pvpOppWords}
function startPvpCountdown(){if(pvpState!=='matched')return;pvpState='countdown';clearTimeout(pvpRoomGuard);pvpMyWords=pvpOppWords=0;pvpIdx=0;pvpOppFinal=null;pvpTimeLeft=PVP_TIME;pvpMyNameEl.textContent=username+' (나)';pvpOppNameEl.textContent=pvpOppName;updatePvpBoard();pvpTimerEl.textContent=PVP_TIME;setPvpView('battle');let c=3;pvpWordDisplay.textContent=c;pvpCountIv=setInterval(()=>{c--;if(c>0)pvpWordDisplay.textContent=c;else{clearInterval(pvpCountIv);beginPvpPlay()}},1000)}
function beginPvpPlay(){if(pvpState!=='countdown')return;pvpState='playing';pvpInputBox.disabled=false;pvpInputBox.value='';pvpInputBox.focus();pvpWordDisplay.textContent=pvpSeq[pvpIdx];pvpGameIv=setInterval(()=>{pvpTimeLeft--;pvpTimerEl.textContent=pvpTimeLeft;if(pvpTimeLeft<=0)finishMyPvpSide()},1000)}
pvpInputBox.addEventListener('input',function(){if(pvpState==='playing'&&pvpInputBox.value.trim()===pvpSeq[pvpIdx]){pvpMyWords++;pvpIdx++;pvpInputBox.value='';pvpWordDisplay.textContent=pvpSeq[pvpIdx];updatePvpBoard();if(roomChannel)roomChannel.send({type:'broadcast',event:'score',payload:{id:pvpId,words:pvpMyWords}})}});
function finishMyPvpSide(){if(pvpState!=='playing')return;pvpState='finished';clearInterval(pvpGameIv);pvpInputBox.disabled=true;if(roomChannel)roomChannel.send({type:'broadcast',event:'final',payload:{id:pvpId,words:pvpMyWords}});pvpFinishTimeout=setTimeout(()=>{if(pvpState==='finished'){pvpOppFinal=pvpOppWords;tryShowPvpResult()}},4000);tryShowPvpResult()}
async function tryShowPvpResult(){if(pvpState!=='finished'||pvpOppFinal===null)return;pvpState='result';clearTimeout(pvpFinishTimeout);const my=pvpMyWords,op=pvpOppFinal,reward=my>op?30:my<op?10:15;const t=document.getElementById('pvpResultTitle');t.textContent=my>op?'🏆 승리!':my<op?'💀 패배...':'🤝 무승부';t.className='pvp-result-title '+(my>op?'pvp-win':my<op?'pvp-lose':'pvp-draw');document.getElementById('pvpResultDesc').innerHTML='나 <b>'+my+'단어</b> vs <b>'+op+'단어</b> '+pvpOppName+'<br>💰 보상: +'+reward+' 코인';setPvpView('result');if(currentUser){userData.coins+=reward;try{await saveUserData()}catch(e){}}cleanupPvpChannels()}
function cleanupPvpChannels(){if(lobbyChannel){try{supabaseClient.removeChannel(lobbyChannel)}catch(e){}lobbyChannel=null}if(roomChannel){try{supabaseClient.removeChannel(roomChannel)}catch(e){}roomChannel=null}}
function resetPvp(){clearInterval(pvpGameIv);clearInterval(pvpCountIv);clearTimeout(pvpFinishTimeout);clearTimeout(pvpRoomGuard);cleanupPvpChannels();pvpState='idle';pvpInputBox.value='';pvpInputBox.disabled=true;setPvpView('status')}
function pvpRematch(){resetPvp();startMatchmaking()}function exitPvp(){resetPvp();pvpScreen.classList.remove('active');homeScreen.classList.add('active');fetchRankings();checkBuffState()}window.addEventListener('beforeunload',cleanupPvpChannels);

        fetchRankings();
        checkAuthState();
    </script>
